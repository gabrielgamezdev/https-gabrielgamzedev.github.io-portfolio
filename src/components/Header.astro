---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Locale } from '../data/profile';
import type { Profile } from '../data/profile';

interface Props {
	lang: Locale;
	profile: Profile;
}

const { lang, profile } = Astro.props;
const other: Locale = lang === 'es' ? 'en' : 'es';
const otherLabel = other === 'es' ? 'ES' : 'EN';
const switchHref = getRelativeLocaleUrl(other);
---

<header class="site-header">
	<div class="site-header__inner">
		<a class="site-brand" href="#top" aria-label="Gabriel Gamez">GG.</a>
		<nav class="site-nav" aria-label="Primary">
			<a href="#experience">{profile.nav.experience}</a>
			<a href="#education">{profile.nav.education}</a>
			<a href="#skills">{profile.nav.skills}</a>
			<a href="#projects">{profile.nav.projects}</a>
			<a href="#contact">{profile.nav.contact}</a>
		</nav>
		<div class="header-actions">
			<a class="icon-btn" href={switchHref} hreflang={other} lang={other} aria-label={lang === 'es' ? 'English' : 'Español'}>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="12" cy="12" r="10" />
					<path d="M2 12h20" />
					<path d="M12 2a15.3 15.3 0 0 1 0 20 15.3 15.3 0 0 1 0-20" />
				</svg>
				<span>{otherLabel}</span>
			</a>
			<button
				type="button"
				class="icon-btn"
				id="theme-toggle"
				aria-label={lang === 'es' ? 'Cambiar tema' : 'Toggle color theme'}
			>
				<svg class="theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
				</svg>
				<svg class="theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<circle cx="12" cy="12" r="4" />
					<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
				</svg>
			</button>
		</div>
	</div>
</header>
