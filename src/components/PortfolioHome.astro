---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProfile, GITHUB_URL, LINKEDIN_URL } from '../data/profile';
import type { Locale } from '../data/profile';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const profile = getProfile(lang);

function splitSkillItems(raw: string): string[] {
	return raw
		.split(',')
		.map((s) => s.trim())
		.filter(Boolean)
		.map((s) => s.replace(/\.\s*$/, ''));
}
---

<BaseLayout lang={lang} profile={profile}>
	<main id="main" class="site-main">
		<div id="top" tabindex="-1"></div>

		<section class="hero" id="about" aria-labelledby="hero-heading">
			<div class="page-shell hero__inner">
				<div>
					<span class="hero-badge">{profile.hero.role}</span>
					<h1 id="hero-heading">Gabriel Jose Gamez Ramirez</h1>
					<p class="hero__tag">{profile.hero.tagline}</p>
					<p class="hero__location">{profile.hero.location}</p>
					<p class="hero__lead">{profile.hero.summary}</p>
					<div class="hero__actions">
						<a class="btn-primary" href="#experience">
							{profile.hero.ctaWork}
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
								<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
								<polyline points="14 2 14 8 20 8" />
								<line x1="16" y1="13" x2="8" y2="13" />
								<line x1="16" y1="17" x2="8" y2="17" />
							</svg>
						</a>
						<a class="btn-secondary" href="#contact">
							{profile.nav.contact}
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
								<path d="M5 12h14M12 5l7 7-7 7" />
							</svg>
						</a>
					</div>
				</div>
				<div class="hero-code" aria-hidden="true">
					<div class="hero-code__glow"></div>
					<div class="hero-code__window">
						<div class="hero-code__dots">
							<span></span><span></span><span></span>
						</div>
						<div class="muted">// Gabriel Gamez</div>
						<div style="margin-top: 0.75rem">
							<span class="kw">const</span> <span class="str">skills</span> <span class="muted">=</span> <span class="muted">[</span>
						</div>
						<div class="str" style="padding-left: 1rem; margin-top: 0.35rem">
							<div>"Ruby on Rails",</div>
							<div>"React",</div>
							<div>"SQL",</div>
							<div>"PostgreSQL",</div>
						</div>
						<div class="muted">];</div>
					</div>
				</div>
			</div>
		</section>

		<section class="section-block section-block--alt" id="experience" aria-labelledby="exp-heading">
			<div class="page-shell">
				<h2 class="section-title section-title--center section-title--left-sm" id="exp-heading">
					{profile.nav.experience}
				</h2>
				{
					profile.experience.map((job) => (
						<article class="exp-card">
							<div class="exp-card__head">
								<div>
									<h3>{job.title}</h3>
									<div class="exp-card__company">
										<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
											<rect x="2" y="7" width="20" height="14" rx="2" ry="2" />
											<path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
										</svg>
										<span>{job.company}</span>
									</div>
								</div>
								<div class="exp-card__period">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
										<rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
										<line x1="16" y1="2" x2="16" y2="6" />
										<line x1="8" y1="2" x2="8" y2="6" />
										<line x1="3" y1="10" x2="21" y2="10" />
									</svg>
									<span>
										{job.period}
										{job.mode ? ` · ${job.mode}` : ''}
									</span>
								</div>
							</div>
							<ul class="exp-list">
								{job.bullets.map((b) => (
									<li>
										<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
											<path d="m9 18 6-6-6-6" />
										</svg>
										<span>{b}</span>
									</li>
								))}
							</ul>
						</article>
					))
				}
			</div>
		</section>

		<section class="section-block" id="education" aria-labelledby="edu-heading">
			<div class="page-shell">
				<h2 class="section-title section-title--center section-title--left-sm" id="edu-heading">
					{profile.nav.education}
				</h2>
				<div class="edu-card">
					<div class="edu-card__row">
						<div class="edu-card__icon" aria-hidden="true">
							<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M22 10v6M2 10l10-5 10 5-10 5z" />
								<path d="M6 12v5c3 3 9 3 12 0v-5" />
							</svg>
						</div>
						<div style="flex: 1">
							<div class="edu-card__meta">
								<h3>{profile.education.degree}</h3>
								<span class="edu-card__date">{profile.education.date}</span>
							</div>
							<p class="edu-card__school">{profile.education.institution}</p>
							<p class="edu-card__honor">
								<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="flex-shrink: 0; color: var(--brand)">
									<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
								</svg>
								<span>{profile.education.honor}</span>
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="section-block section-skills-dark section-block--tight" id="skills" aria-labelledby="skills-heading">
			<div class="visible-grid" aria-hidden="true"></div>
			<div class="page-shell">
				<h2 class="section-title section-title--center section-title--left-sm" id="skills-heading">
					{profile.nav.skills}
				</h2>
				<div class="skills-columns">
					{
						profile.skills.map((group) => (
							<div class="skills-col">
								<h3>{group.category}</h3>
								<div class="skill-chips">
									{splitSkillItems(group.items).map((item) => (
										<span class="skill-chip">{item}</span>
									))}
								</div>
							</div>
						))
					}
				</div>
				<p class="skills-lang">
					<strong>{lang === 'es' ? 'Idiomas' : 'Languages'}: </strong>
					{profile.languages}
				</p>
			</div>
		</section>

		<section class="section-block section-block--alt" id="projects" aria-labelledby="proj-heading">
			<div class="page-shell">
				<h2 class="section-title section-title--center section-title--left-sm" id="proj-heading">
					{profile.nav.projects}
				</h2>
				<div class="proj-card">
					<p style="margin: 0">{profile.projects.body}</p>
				</div>
			</div>
		</section>

		<footer class="site-footer" id="contact">
			<div class="page-shell">
				<div class="footer-grid">
					<div>
						<h2 class="footer-lead">{profile.footer.title}</h2>
						<p class="footer-blurb">{profile.footer.blurb}</p>
						<div class="footer-social">
							<a href={`mailto:${profile.contact.email}`} aria-label="Email">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<rect width="20" height="16" x="2" y="4" rx="2" />
									<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
								</svg>
							</a>
							<a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" aria-label={profile.contact.linkedInLabel}>
								<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path
										d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
									/>
								</svg>
							</a>
							<a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" aria-label={profile.contact.githubLabel}>
								<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path
										d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.775.417-1.305.762-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
									/>
								</svg>
							</a>
						</div>
					</div>
					<div class="footer-card">
						<div class="footer-card__email">{profile.contact.email}</div>
						<a class="btn-primary" href={`mailto:${profile.contact.email}`}>{profile.footer.ctaHello}</a>
					</div>
				</div>
			</div>
		</footer>
	</main>
</BaseLayout>
